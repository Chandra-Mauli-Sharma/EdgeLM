<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loopback ServerSocket for the OpenAI-compatible HTTP shim (127.0.0.1:1408). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Ongoing "EdgeLM running" notification + keeping the shared runtime alive
         against aggressive OEM freezers while apps are actively using it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Model downloads run via WorkManager as a dataSync foreground worker so a
         large transfer survives the app closing / process death. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The gate to the shared runtime. Any app that wants to bind EdgeLM must
         declare this permission; it's enforced by the OS on the service below.
         The EdgeLM SDK declares it for consumers automatically (manifest merge),
         so integrating apps get it for free. protectionLevel="normal" = granted
         at install and visible on the app's Play listing (auditable, no ecosystem
         friction). Per-app user consent can layer on top later. -->
    <permission
        android:name="ai.edgelm.permission.USE_RUNTIME"
        android:protectionLevel="normal"
        android:label="Use on-device AI (EdgeLM)"
        android:description="@string/perm_use_runtime_desc" />

    <!-- The runtime app itself binds its own service (status screen), so it holds
         the permission too. -->
    <uses-permission android:name="ai.edgelm.permission.USE_RUNTIME" />

    <!-- Phase 1 capability permissions (arch doc Part 7). These are the fine-grained
         AI capabilities an app declares to state INTENT (auditable on its Play
         listing). protectionLevel="normal" so they're install-granted and visible;
         EdgeLM's CapabilityBroker layers the actual runtime grant/deny/consent on
         top (grant-on-first-use for low-risk; explicit consent for high-risk). An
         app must <uses-permission> the matching capability before the broker allows
         it — declaration is necessary but not sufficient. -->
    <permission android:name="ai.edgelm.CHAT" android:protectionLevel="normal"
        android:label="On-device AI chat (EdgeLM)"
        android:description="@string/perm_chat_desc" />
    <permission android:name="ai.edgelm.EMBED" android:protectionLevel="normal"
        android:label="On-device AI embeddings (EdgeLM)"
        android:description="@string/perm_embed_desc" />
    <permission android:name="ai.edgelm.VISION" android:protectionLevel="normal"
        android:label="On-device AI vision (EdgeLM)"
        android:description="@string/perm_vision_desc" />
    <permission android:name="ai.edgelm.BACKGROUND_INFERENCE" android:protectionLevel="normal"
        android:label="Background on-device AI (EdgeLM)"
        android:description="@string/perm_background_desc" />

    <!-- The runtime app holds CHAT itself (its Playground uses the shared engine). -->
    <uses-permission android:name="ai.edgelm.CHAT" />

    <application
        android:name="ai.edgelm.runtime.EdgeLMApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="EdgeLM Runtime"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false">

        <!-- Remove WorkManager's default auto-initializer so it initializes ON DEMAND via
             EdgeLMApp (Configuration.Provider) instead. The default initializer only runs
             in the main process, which breaks WorkManager.getInstance() in the :core
             service (e.g. the shim's /v1/edge/pull). On-demand init works in every process. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- LiteRT-LM GPU (OpenCL) backend needs these vendor libs at runtime (Phase B).
             required=false so devices without them still install and run on the CPU engine. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <!--
          The shared runtime. Runs in its OWN process (:core) so that model
          weights mmap'd here are shared across every bound app via the OS
          page cache — the crux of the Phase 0 thesis.

          exported=true so other apps' processes can bind, but android:permission
          gates every bind: only callers holding ai.edgelm.permission.USE_RUNTIME
          get through. The OS enforces this before onBind is ever reached.
        -->
        <service
            android:name="ai.edgelm.service.EdgeLMService"
            android:process=":core"
            android:exported="true"
            android:permission="ai.edgelm.permission.USE_RUNTIME"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <!-- No standard FGS type fits a shared, general-purpose on-device
                 inference runtime; "specialUse" is the honest declaration.
                 (Play requires this justification string at review time.) -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shared on-device AI inference runtime serving other apps' local model requests." />
            <intent-filter>
                <action android:name="ai.edgelm.BIND_RUNTIME" />
            </intent-filter>
        </service>

        <!-- Model downloads run via WorkManager (DownloadWorker) so they survive the
             app closing / process death. WorkManager's own foreground service needs
             the dataSync type declared on API 34+. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- In-app chat playground to smoke-test the runtime + active model. -->
        <activity
            android:name="ai.edgelm.runtime.PlaygroundActivity"
            android:exported="false"
            android:label="EdgeLM Playground"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.EdgeLM.Runtime" />

        <!-- First-run onboarding. -->
        <activity
            android:name="ai.edgelm.runtime.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.EdgeLM.Runtime" />

        <!-- Consent surface for high-risk capabilities (Part 7). Launched by an app
             via EdgeLM.permissions().request(...) → action ai.edgelm.REQUEST_CAPABILITY.
             exported=true so other apps can launch it for their own consent; it records
             the decision for the resolved (referrer-verified) package. Excluded from
             recents so it behaves like a system permission dialog. -->
        <activity
            android:name="ai.edgelm.runtime.PermissionConsentActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.EdgeLM.Runtime">
            <intent-filter>
                <action android:name="ai.edgelm.REQUEST_CAPABILITY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Landing / status screen so the runtime is a real, openable, listable app. -->
        <activity
            android:name="ai.edgelm.runtime.RuntimeActivity"
            android:exported="true"
            android:theme="@style/Theme.EdgeLM.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
